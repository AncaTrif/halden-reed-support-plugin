{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__claude_ai_Gmail__(send_message|reply|forward)|mcp__zoho__ZohoDesk_sendReply",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/block_customer_send.py\""
          }
        ]
      },
      {
        "matcher": "mcp__slack__slack_send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/redact_slack.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__slack__slack_search_channels",
      "mcp__orders__get_order",
      "Write(drafts/**)",
      "mcp__zoho__ZohoDesk_getTicket",
      "mcp__zoho__ZohoDesk_getTickets",
      "mcp__zoho__ZohoDesk_searchTickets",
      "mcp__zoho__ZohoDesk_getTicketConversations",
      "mcp__zoho__ZohoDesk_getContact"
    ],
    "ask": [
      "mcp__slack__slack_send_message",
      "mcp__slack__slack_read_channel",
      "mcp__slack__slack_read_thread"
    ],
    "deny": [
      "mcp__slack__slack_add_list_record",
      "mcp__slack__slack_add_reaction",
      "mcp__slack__slack_complete_file_upload",
      "mcp__slack__slack_create_canvas",
      "mcp__slack__slack_create_conversation",
      "mcp__slack__slack_create_list",
      "mcp__slack__slack_get_file_upload_url",
      "mcp__slack__slack_get_reactions",
      "mcp__slack__slack_list_channel_members",
      "mcp__slack__slack_list_user_channels",
      "mcp__slack__slack_read_canvas",
      "mcp__slack__slack_read_file",
      "mcp__slack__slack_read_list",
      "mcp__slack__slack_read_user_profile",
      "mcp__slack__slack_schedule_message",
      "mcp__slack__slack_search_emojis",
      "mcp__slack__slack_search_public",
      "mcp__slack__slack_search_public_and_private",
      "mcp__slack__slack_search_users",
      "mcp__slack__slack_send_message_draft",
      "mcp__slack__slack_update_canvas",
      "mcp__slack__slack_update_list",
      "mcp__slack__slack_update_list_record",
      "mcp__zoho__ZohoDesk_sendReply",
      "mcp__zoho__ZohoDesk_draftsReply",
      "mcp__zoho__ZohoDesk_sendForReview",
      "mcp__zoho__ZohoDesk_createTicket",
      "mcp__zoho__ZohoDesk_updateTicket",
      "mcp__zoho__ZohoDesk_updateManyTickets",
      "mcp__zoho__ZohoDesk_bulkUpdateTickets",
      "mcp__zoho__ZohoDesk_deleteTicket",
      "mcp__zoho__ZohoDesk_deleteSpamTickets",
      "mcp__zoho__ZohoDesk_deleteAllSpamTickets",
      "mcp__zoho__ZohoDesk_createTicketComment",
      "mcp__zoho__ZohoDesk_updateTicketComment",
      "mcp__zoho__ZohoDesk_deleteTicketComment",
      "mcp__zoho__ZohoDesk_moveTicket",
      "mcp__zoho__ZohoDesk_mergeTicket",
      "mcp__zoho__ZohoDesk_mergeTickets",
      "mcp__zoho__ZohoDesk_splitTicket",
      "mcp__zoho__ZohoDesk_closeTickets",
      "mcp__zoho__ZohoDesk_markTicketAsSpam",
      "mcp__zoho__ZohoDesk_createContact",
      "mcp__zoho__ZohoDesk_updateContact",
      "mcp__zoho__ZohoDesk_deleteContact",
      "mcp__zoho__ZohoDesk_addAgent",
